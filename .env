# Credenciales del servidor remoto para despliegue
# (Conéctate con tu usuario normal; el script se encargará de elevar a root usando su -c)
REMOTE_USER=huma
REMOTE_HOST=gestionhuma.unca.edu.ar
REMOTE_PORT=2220
# Ruta a la carpeta autodeploy de glassfish en el volumen montado del servidor remoto
REMOTE_PATH=/var/lib/docker/volumes/dev-sistema-huma_glassfish_full/_data/glassfish/domains/domain1/autodeploy

